-- ===== NOTIFICATION SYSTEM =====
local function notify(title, message)
	if not snipeSettings.notifications then return end
	-- Use Fluent notification if available, fallback to print
	pcall(function()
		Fluent:Notify({
			Title = title,
			Content = message,
			Duration = 4
		})
	end)
	print("📢 " .. title .. ": " .. message)
end

-- ===== GET PRICE FROM OBJECT =====
local function getPrice(obj)
	-- Try common price value locations
	local priceObj = obj:FindFirstChild("Price")
		or obj:FindFirstChild("Cost")
		or obj:FindFirstChild("Value")
	if priceObj then
		if priceObj:IsA("NumberValue") or priceObj:IsA("IntValue") then
			return priceObj.Value
		end
	end
	-- Try searching one level deeper
	for _, child in ipairs(obj:GetChildren()) do
		local v = child:FindFirstChild("Price") or child:FindFirstChild("Cost")
		if v and (v:IsA("NumberValue") or v:IsA("IntValue")) then
			return v.Value
		end
	end
	return 0
end

-- ===== BOOTH SCANNER =====
local function scanBooths()
	detectionLog = {}
	boothsData = {}
	sniperStats.totalScans = sniperStats.totalScans + 1

	table.insert(detectionLog, "🔍 Scanning workspace...")

	local foundCount = 0
	local seen = {} -- avoid duplicate entries for same object

	for _, obj in ipairs(workspace:GetDescendants()) do
		if not seen[obj] and PET_SET[obj.Name] then
			seen[obj] = true

			-- Walk up to find a reasonable booth name
			local boothName = "Unknown Booth"
			local ancestor = obj.Parent
			for _ = 1, 5 do
				if ancestor and ancestor ~= workspace then
					boothName = ancestor.Name
					ancestor = ancestor.Parent
				else
					break
				end
			end

			local price = getPrice(obj)

			if price <= snipeSettings.maxPrice then
				foundCount = foundCount + 1
				table.insert(detectionLog, "✓ " .. obj.Name .. " @ " .. boothName .. " — " .. tostring(price) .. " tokens")
				table.insert(boothsData, {
					Name = obj.Name,
					Booth = boothName,
					Price = price,
					Object = obj
				})
			end
		end
	end

	if foundCount == 0 then
		table.insert(detectionLog, "❌ No pets found in workspace")
	else
		table.insert(detectionLog, "✅ Found " .. foundCount .. " pet(s)!")
	end

	notify("Scan Complete", foundCount .. " pet(s) found")
	print("Scan complete: " .. foundCount .. " pets found")
	return foundCount
end

-- ===== TELEPORT CHARACTER =====
local function teleportToObject(obj)
	local char = player.Character
	if not char then return end
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then return end
	-- Try to get a CFrame from the object
	local cf
	pcall(function()
		if obj:IsA("BasePart") then
			cf = obj.CFrame + Vector3.new(0, 5, 0)
		elseif obj:IsA("Model") and obj.PrimaryPart then
			cf = obj.PrimaryPart.CFrame + Vector3.new(0, 5, 0)
		end
	end)
	if cf then
		root.CFrame = cf
	end
end

-- ===== AUTO REJOIN =====
local function rejoinGame()
	if snipeSettings.autoRejoin then
		notify("🔄 Rejoining", "Rejoining game in 3 seconds...")
		task.wait(3)
		TeleportService:Teleport(game.PlaceId, player)
	end
end

-- ===== AUTO SNIPE LOOP (runs via task.spawn, non-blocking) =====
local function snipeLoop()
	while isAutoSniping do
		if #selectedPets == 0 then
			task.wait(1)
			continue
		end

		-- Rescan every cycle
		scanBooths()

		for _, booth in ipairs(boothsData) do
			if not isAutoSniping then break end

			for _, selectedPet in ipairs(selectedPets) do
				if booth.Name == selectedPet and booth.Price <= snipeSettings.maxPrice then
					-- Record stats
					sniperStats.sniped = sniperStats.sniped + 1
					sniperStats.tokensSpent = sniperStats.tokensSpent + booth.Price

					-- Keep history capped at 50 entries
					table.insert(sniperStats.history, {
						pet = booth.Name,
						price = booth.Price,
						booth = booth.Booth,
						time = os.date("%H:%M:%S")
					})
					if #sniperStats.history > 50 then
						table.remove(sniperStats.history, 1)
					end

					notify("🎯 SNIPED!", booth.Name .. " for " .. booth.Price .. " tokens at " .. booth.Booth)

					-- Auto teleport
					if snipeSettings.autoTeleport and booth.Object then
						teleportToObject(booth.Object)
					end

					-- Auto rejoin
					rejoinGame()

					break
				end
			end
		end

		-- Speed controls how fast we loop (higher = faster)
		task.wait(math.max(0.1, 1 / snipeSettings.snipeSpeed))
	end
end

-- ===== AUTO SCAN LOOP (separate from snipe loop) =====
local function autoScanLoop()
	while isAutoScanning do
		scanBooths()
		task.wait(5)
	end
end

