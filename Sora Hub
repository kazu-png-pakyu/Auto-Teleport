-- ===== NOTIFICATION SYSTEM =====
local function notify(title, message)
	if not snipeSettings.notifications then return end
	print("📢 " .. title .. ": " .. message)
end

-- ===== BOOTH SCANNER =====
local function scanBooths()
	detectionLog = {}
	boothsData = {}
	sniperStats.totalScans = sniperStats.totalScans + 1
	
	table.insert(detectionLog, "🔍 Scanning booths...")
	
	local foundCount = 0
	
	local function checkObject(obj)
		for _, petName in ipairs(PET_LIST) do
			if obj.Name == petName then
				local parent = obj.Parent
				local boothName = "Unknown Booth"
				
				if parent and parent.Parent then
					boothName = parent.Parent.Name or "Booth"
				end
				
				local price = 0
				if obj:FindFirstChild("Price") then
					price = obj.Price.Value
				elseif obj:FindFirstChild("Value") then
					price = obj.Value.Value
				end
				
				-- Check if pet matches filters
				if price <= snipeSettings.maxPrice then
					foundCount = foundCount + 1
					table.insert(detectionLog, "✓ " .. petName .. " - " .. boothName .. " (" .. tostring(price) .. " tokens)")
					table.insert(boothsData, {
						Name = petName,
						Booth = boothName,
						Price = price,
						Object = obj
					})
				end
				return true
			end
		end
		return false
	end
	
	for _, obj in ipairs(workspace:GetDescendants()) do
		checkObject(obj)
	end
	
	if foundCount == 0 then
		table.insert(detectionLog, "❌ No pets found matching filters")
	else
		table.insert(detectionLog, "✅ Found " .. foundCount .. " pets!")
	end
	
	notify("Scan Complete", foundCount .. " pets found")
	print("Scan complete: " .. foundCount .. " pets found")
	return foundCount
end

-- ===== AUTO SNIPE FUNCTION =====
local function autoSnipe()
	if not isAutoSniping or #selectedPets == 0 then return end
	
	for _, booth in ipairs(boothsData) do
		for _, selectedPet in ipairs(selectedPets) do
			if booth.Name == selectedPet and booth.Price <= snipeSettings.maxPrice then
				-- Snipe the pet
				sniperStats.sniped = sniperStats.sniped + 1
				sniperStats.tokensSpent = sniperStats.tokensSpent + booth.Price
				
				table.insert(sniperStats.history, {
					pet = booth.Name,
					price = booth.Price,
					booth = booth.Booth,
					time = os.date("%H:%M:%S")
				})
				
				notify("🎯 SNIPED!", booth.Name .. " for " .. booth.Price .. " tokens")
				
				-- Auto teleport if enabled
				if snipeSettings.autoTeleport and booth.Object then
					player.Character:MoveTo(booth.Object.Position)
				end
				
				-- Wait based on snipe speed
				wait(1 / snipeSettings.snipeSpeed)
			end
		end
	end
end

-- ===== AUTO REJOIN =====
local function rejoinGame()
	if snipeSettings.autoRejoin then
		notify("🔄 Rejoining", "Rejoining game...")
		wait(2)
		game:GetService("TeleportService"):Teleport(game.PlaceId, player)
	end
end

