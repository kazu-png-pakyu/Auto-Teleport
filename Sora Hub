-- ===== HEARTBEAT: update labels at most 2x per second =====
RunService.Heartbeat:Connect(function()
	local now = tick()

	-- Update scan log label
	if now - lastLogUpdate >= 0.5 and #detectionLog > 0 then
		lastLogUpdate = now
		local lines = {}
		-- Show last 15 lines to avoid overflow
		local start = math.max(1, #detectionLog - 14)
		for i = start, #detectionLog do
			table.insert(lines, detectionLog[i])
		end
		logLabel:Set(table.concat(lines, "\n"))
	end

	-- Update stats label
	if now - lastStatsUpdate >= 0.5 then
		lastStatsUpdate = now
		local avg = sniperStats.sniped > 0
			and math.floor(sniperStats.tokensSpent / sniperStats.sniped)
			or 0

		local txt = "Pets Sniped:  " .. sniperStats.sniped .. "\n"
			.. "Tokens Spent: " .. sniperStats.tokensSpent .. "\n"
			.. "Total Scans:  " .. sniperStats.totalScans .. "\n"
			.. "Avg Price:    " .. avg .. " tokens\n"
			.. "Status:       " .. (isAutoSniping and "🟢 ACTIVE" or "🔴 IDLE") .. "\n\n"
			.. "— Recent History —\n"

		local histStart = math.max(1, #sniperStats.history - 9)
		for i = histStart, #sniperStats.history do
			local e = sniperStats.history[i]
			if e then
				txt = txt .. e.time .. "  " .. e.pet .. "  (" .. e.price .. ")\n"
			end
		end

		statsLabel:Set(txt)
	end
end)

